import AddGuarantor from "@/modules/views/Admin/ManBorrower/Guarantor/conponents/AddGuarantor"
import AppLayout from "@/components/DashboardLayout/AppLayout"
import PageTitle from "@/components/DashboardLayout/DashMeta"
import ContentNavbar from "@/components/DashboardLayout/DashNavbar"
import Sidebar from "@/components/DashboardLayout/DashSidebar"
import { getSession } from 'next-auth/react'
import jwt_decode from "jwt-decode"
import { useEffect, useState } from "react"
import LoadingCard from "@/components/LoadingCard"

export default function AddGuarantorPage(props) {
  let decoded = jwt_decode(props?.jwt);
  let role_permz = decoded?.permissions

  return (
    <>
      <AppLayout>
        <PageTitle title="Add Guarantor" />
        <ContentNavbar session={props} />
        <Sidebar session={props} permissions={decoded} />

        {typeof (decoded) == "undefined" ? (
          <>
            <LoadingCard />
          </>
        ) : (
          <>
            {typeof (role_permz) != "undefined" && role_permz.includes("User.create") ? (
              <AddGuarantor />
            ) : (
              <>
                <div className="row mt-3 mb-2">
                  <div className="col-12">
                    <div className="alert alert-danger">
                      <strong>Sorry !! You are not permitted to view this Page </strong>
                    </div>
                  </div>
                </div>
              </>
            )}
          </>
        )}
      </AppLayout>
    </>
  )
}

export async function getServerSideProps({ req }) {
  const session = await getSession({ req })
  return { props: { ...session } }
} 